#!/usr/bin/env bash

# Non-secret AWS deployment settings. Copy outside Git, replace the examples,
# then source it before run-env.sh.
export EXPERIMENT_PROFILE=normalized
export MONITORING_PROFILE=aws
export AWS_REGION=ca-central-1
export AWS_ACCOUNT_ID=REPLACE_ME
export REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
export S3_BUCKET=REPLACE_ME

# SSH destination and private address of the separate Kafka/generator EC2 host.
export TARGET_HOST=ec2-user@kafka.internal.example
export TARGET_IP=192.0.2.10
export HOST_TAG=aws-kafka
export DATA_DIR=/data/kafka

# EKS reaches the external broker through the Service/Endpoints alias.
export KAFKA_BOOTSTRAP=kafka-external:9092
export BOOTSTRAP_SERVERS=kafka:9092
export KUBECONFIG=/replace/with/eks-kubeconfig
